2904 0 obj
  << /ActualText (Stage 1\072 \nRegister as an exporter \050one\055time\051\056 Before your first shipment you need four things\056 The Import Export Code \050IEC\051 from DGFT is mandatory and cheap \050around \271500\051 \024 without it nothing moves\056 GST registration lets you export \042zero\055rated\042 and claim refunds\056 The AD Code is a 14\055digit code from your bank\054 registered on ICEGATE\054 so your foreign payment links back to your account\056 And an RCMC \050Registration\055Cum\055Membership Certificate\051 from the relevant Export Promotion Council is what unlocks the incentive schemes\056 The RCMC is optional to trade but worth getting early\054 since the incentives meaningfully affect profitability)
     /K [ 269 ]
     /P 2905 0 R
     /Pg 2402 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

2905 0 obj
  << /K [ 2904 0 R ]
     /P 2936 0 R
     /S /P
     /Pg 2402 0 R
     /Type /StructElem
  >>
endobj

2906 0 obj
  << /ActualText (2\056 Line up the deal\nbuyer\054 Incoterms\054 invoice\054 packing list)
     /K [ 270 ]
     /P 2907 0 R
     /Pg 2402 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

2907 0 obj
  << /K [ 2906 0 R ]
     /P 2936 0 R
     /S /P
     /Pg 2402 0 R
     /Type /StructElem
  >>
endobj

2908 0 obj
  << /ActualText (Stage 2 \nLine up the deal\056 Find the buyer\054 agree terms with clear Incoterms \050EXW\054 FOB\054 CIF\054 etc\056 \024 this defines who pays freight and insurance and who carries the risk\051\054 and settle a payment method \050Letter of Credit is safest but costlier\073 advance\054 documentary collection\054 or open account are the alternatives\051\056 You prep the core commercial documents\072 commercial invoice\054 packing list\054 and later the bill of lading or airway bill\056)
     /K [ 271 ]
     /P 2909 0 R
     /Pg 2402 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

